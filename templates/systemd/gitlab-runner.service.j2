[Unit]
Description=GitLab Runner ({{ gitlab_runner_identifier }})
{% for service in gitlab_runner_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in gitlab_runner_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ gitlab_runner_container_cleanup_command | trim | replace("\n", " ") }}'

{#
  The command is overridden, as the image's default one works in a directory `gitlab_runner_uid` cannot write to.
  The metrics address is passed here rather than in `config.toml`, as GitLab Runner only reads it on startup.
  SIGQUIT lets running jobs finish before the container stops.
#}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ gitlab_runner_identifier }} \
      --log-driver=none \
      --user={{ gitlab_runner_uid }}:{{ gitlab_runner_gid }} \
      --group-add={{ gitlab_runner_container_docker_socket_gid_effective }} \
      --cap-drop=ALL \
      --security-opt=no-new-privileges \
      --read-only \
      --tmpfs=/tmp:rw,noexec,nosuid,size={{ gitlab_runner_container_tmp_size }} \
      --network={{ gitlab_runner_container_network }} \
      --stop-signal=SIGQUIT \
      {% if gitlab_runner_config_metrics_enabled | bool and gitlab_runner_container_metrics_host_bind_port %}
      -p {{ gitlab_runner_container_metrics_host_bind_port }}:9252 \
      {% endif %}
      --mount type=bind,src={{ gitlab_runner_config_path }},dst=/etc/gitlab-runner \
      --mount type=bind,src={{ gitlab_runner_container_docker_socket_path_host }},dst=/var/run/docker.sock \
      {% for arg in gitlab_runner_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ gitlab_runner_container_image }} \
      run --config=/etc/gitlab-runner/config.toml --working-directory=/tmp{% if gitlab_runner_config_metrics_enabled | bool %} --listen-address=:9252{% endif %}


{% for network in gitlab_runner_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ gitlab_runner_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ gitlab_runner_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ gitlab_runner_container_stop_grace_time_seconds }} {{ gitlab_runner_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ gitlab_runner_identifier }} 2>/dev/null || true'

{# Leave enough time for `docker stop` (above, and in the cleanup before starting) to finish gracefully, before systemd kills it. #}
TimeoutStartSec={{ gitlab_runner_container_stop_grace_time_seconds | int + (gitlab_runner_container_cleanup_timeout_seconds | int) * (gitlab_runner_container_cleanup_retry_delay_seconds | int) + 60 }}
TimeoutStopSec={{ gitlab_runner_container_stop_grace_time_seconds | int + 30 }}
Restart=always
RestartSec=30
SyslogIdentifier={{ gitlab_runner_identifier }}

[Install]
WantedBy=multi-user.target
